<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- Header Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="INA SAFE"
            app:titleTextColor="@color/white"
            android:background="@color/ina_red" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Bottom Navigation Bar (Included) -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <!-- Main Content (Panic & Report) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="40dp"
                android:src="@drawable/ic_shield" />

            <!-- Panic Button Container for Animation -->
            <!-- Use clipChildren="false" to allow pulse to go outside bounds -->
            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false">
                
                <!-- Pulse Effect View (Smaller than container but scales up) -->
                <View
                    android:id="@+id/pulseView"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_circle_button"
                    android:alpha="0.3"
                    android:layout_gravity="center"/>

                <Button
                    android:id="@+id/btnPanic"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/bg_panic_ripple"
                    android:text="SOS"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    app:backgroundTint="@null"
                    android:elevation="8dp"/>
            </FrameLayout>

            <Button
                android:id="@+id/btnReport"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/ina_red_dark"
                android:text="REPORTAR INCIDENTE"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <!-- Quick Emergency Calls -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Llamadas de Emergencia"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/btnCallPolice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_carabineros"
                        android:padding="0dp"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="#006400"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="133"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCallAmbulance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_hospital"
                        android:padding="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="#F44336"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="131"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btnCallFire"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_warning"
                        android:padding="8dp"
                        app:tint="@color/white"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="#FF9800"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="132"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>