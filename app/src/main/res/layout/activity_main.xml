<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <!-- Header Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="INA SAFE"
            app:titleTextColor="@color/white"
            android:background="@color/ina_red" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Bottom Navigation Bar (Included) -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <!-- Main Content (Panic & Report) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="40dp"
                android:src="@drawable/ic_shield" />

            <!-- Panic Button Container for Animation -->
            <FrameLayout
                android:layout_width="226dp"
                android:layout_height="212dp"
                android:layout_marginBottom="24dp">

                <!-- Pulse Effect View -->
                <View
                    android:id="@+id/pulseView"
                    android:layout_width="172dp"
                    android:layout_height="178dp"
                    android:layout_gravity="center"
                    android:alpha="0.3"
                    android:background="@drawable/bg_circle_button"
                    android:scaleX="1.0"
                    android:scaleY="1.0" />

                <Button
                    android:id="@+id/btnPanic"
                    android:layout_width="138dp"
                    android:layout_height="141dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_button"
                    android:elevation="8dp"
                    android:text="SOS"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </FrameLayout>

            <Button
                android:id="@+id/btnReport"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/ina_red_dark"
                android:text="REPORTAR INCIDENTE"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>